FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
{{- if eq .PackageManager "yarn" }}
COPY yarn.lock ./
{{- else if eq .PackageManager "pnpm" }}
COPY pnpm-lock.yaml ./
{{- end }}
RUN {{ .PackageManager }} install
COPY . .
{{- if .BuildCommand }}
RUN {{ .BuildCommand }}
{{- end }}

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app ./
EXPOSE {{ .ExposedPort }}
ENV PORT={{ .ExposedPort }}
CMD ["sh", "-c", "{{ .StartCommand }}"]
