FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .BuildCommand }}
RUN {{ .BuildCommand }}
{{- else }}
RUN go build -o app .
{{- end }}

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/app ./
EXPOSE {{ .ExposedPort }}
ENV PORT={{ .ExposedPort }}
CMD ["./app"]
